# What a sandbox's `shaked worker` runs with (read by start.sh and bake.sh). build-template.sh
# appends SHAKED_LINK and SHAKED_AGENT_IMAGE, baked into each template.
# No key of any kind belongs here: the sandbox's only credential is its branch's worker token.

# The agent network (agent-network.sh) and where the worker serves its CLI agents on it.
SHAKED_AGENT_NETWORK=shaked-agents
SHAKED_AGENT_SUBNET=10.250.0.0/24
SHAKED_AGENT_LISTEN=10.250.0.1:4610

# The packages, their programs and the worker's own folders.
SHAKEDOWN_PACKAGES=/opt/shakedown/integrations:/opt/shakedown/benchmarks
SHAKEDOWN_BIN_DIR=/opt/shakedown/bin
SHAKEDOWN_WORLDS=/var/lib/shakedown/worlds
SHAKEDOWN_SAVES=/var/lib/shakedown/saves

# Runs reach no package index: the packages' environments are synced at build time.
UV_OFFLINE=1
UV_PYTHON_DOWNLOADS=never
