{
  "seed": 1,
  "tick_ms": 200,
  "timeout_s": 2,
  "workers": 16,
  "max_pending": 256,
  "retention_minutes": 360,
  "export_every_s": 15,
  "environment": "production",
  "user_agent": "shop-customer/1.0 (synthetic traffic)",
  "services": {
    "storefront": "http://prod-storefront:8000",
    "orders": "http://prod-orders:8000",
    "inventory": "http://prod-inventory:8000"
  },
  "slo": {"window_minutes": 30, "objective": 0.01},
  "contracts": {"every_s": 60},
  "day": {
    "start_hour": 9,
    "hourly": [0.25, 0.18, 0.12, 0.10, 0.10, 0.14, 0.25, 0.45, 0.65, 0.80, 0.85, 0.90,
               0.95, 0.90, 0.85, 0.85, 0.90, 0.95, 1.00, 1.00, 0.90, 0.75, 0.55, 0.38]
  },
  "journeys": {
    "browse": {
      "rpm": 30,
      "steps": [{"method": "GET", "service": "storefront", "path": "/products"}]
    },
    "order": {
      "rpm": 3,
      "draw": {"qty": {"int": [1, 2]}, "customer": {"int": [1, 5000], "format": "customer-{:05d}"}},
      "steps": [
        {"method": "GET", "service": "storefront", "path": "/products",
         "pick": {"sku": {"from": "/products", "where": "available", "take": "/sku"}}},
        {"method": "POST", "service": "storefront", "path": "/cart", "save": {"cart_id": "/id"}},
        {"method": "POST", "service": "storefront", "path": "/cart/{cart_id}/items",
         "json": {"sku": "{sku}", "qty": "{qty}"}},
        {"method": "POST", "service": "storefront", "path": "/checkout",
         "json": {"cart_id": "{cart_id}", "customer": "{customer}"}, "save": {"order_id": "/order_id"}},
        {"method": "GET", "service": "storefront", "path": "/orders/{order_id}"}
      ]
    },
    "check-stock": {
      "rpm": 6,
      "steps": [
        {"method": "GET", "service": "inventory", "path": "/stock",
         "pick": {"sku": {"from": "/items", "where": "available", "take": "/sku"}}},
        {"method": "GET", "service": "inventory", "path": "/stock/{sku}"}
      ]
    }
  },
  "events": {
    "traffic-peak": {"at_minute": 90, "for_minutes": 30, "factor": 3}
  }
}
